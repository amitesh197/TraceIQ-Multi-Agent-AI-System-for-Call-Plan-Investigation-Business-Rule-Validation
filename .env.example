# Copy to .env and fill in. Never commit .env. All settings are read on the server.

# ---------- AI model (Gemini free tier via Google AI Studio) ----------
# Mode: "llm" uses the model below, "offline" runs without an LLM. Leave empty to auto-detect from the keys.
TRACEIQ_MODE=
TRACEIQ_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
# Free tiers allow few requests per minute: retries back off automatically. Pause (seconds) between calls if needed.
TRACEIQ_PAUSE_SECONDS=0

# ---------- Data (DuckDB runs the queries in memory) ----------
# "local" reads data/jib_aws; "s3" reads the tables from your bucket (uploaded by scripts/load_athena.py)
TRACEIQ_DATA_SOURCE=local
TRACEIQ_S3_BUCKET=
AWS_REGION=us-east-1

# ---------- Memory per user ----------
# "dynamodb" (table created by scripts/setup_dynamodb.py) or "local" (JSON files on the server)
TRACEIQ_MEMORY=local
TRACEIQ_DDB_TABLE=traceiq_memory
# Server-side folder for local memory and ChromaDB
TRACEIQ_STATE_DIR=

# ---------- Vector search (ChromaDB on the server) ----------
# "local" = free open-source embedding model run on the server; "gemini" = Gemini embeddings; "hash" = no-download fallback
TRACEIQ_EMBEDDINGS=local
TRACEIQ_EMBED_MODEL=gemini/gemini-embedding-001
# Leave empty to run Chroma inside the app server. Set to use a separate Chroma server (chroma run ...).
CHROMA_HOST=
CHROMA_PORT=8000

# ---------- LangSmith (optional): smith.langchain.com > Settings > API Keys ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=traceiq
